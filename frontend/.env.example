# Copy to .env.local to override. All build-time (Vite inlines VITE_* into the bundle at build) —
# never put a real secret here. These are the only knobs; the internal API key is NOT one of them —
# in production it lives on the Caddy proxy, never in the browser bundle (see the root README).

# Where API calls go.
#   Local dev: the backend directly (an absolute URL; the Swagger link also points here).
#   Production: "/api" — same-origin, through the Caddy proxy that fronts the private API.
VITE_API_BASE=http://localhost:8080

# Umami (privacy-first, cookieless analytics). Leave both unset and NO analytics code ships.
# Set both to enable click tracking. Get them from your Umami instance's tracking snippet, e.g.
#   VITE_UMAMI_SRC=https://cloud.umami.is/script.js
#   VITE_UMAMI_WEBSITE_ID=<the website UUID Umami shows you>
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=

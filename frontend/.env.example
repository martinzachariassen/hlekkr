# Copy to .env.local to override. All build-time (Vite inlines VITE_* into the bundle) — never put a
# real secret here.

# Where the API lives. Defaults to the local backend.
VITE_API_BASE=http://localhost:8080

# Umami (privacy-first, cookieless analytics). Leave both unset and NO analytics code ships.
# Set both to enable click tracking. Get them from your Umami instance's tracking snippet.
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=

# Only for a direct-to-API deployment that enforces INTERNAL_API_KEY. In production this key belongs
# on a server-side proxy, not shipped to browsers — see the root README. Leave blank for local dev.
VITE_INTERNAL_KEY=

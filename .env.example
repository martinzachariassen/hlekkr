# Optional overrides for `docker compose up`. The compose file ships with dev-only defaults, so
# you can run the stack with NO .env at all. Copy this to .env only to change something — and for
# any real deployment, set strong values here (or in your platform's secret store). .env is
# git-ignored and must never be committed.

# --- Database ---
POSTGRES_DB=shortener

# Privileged role: owns the schema and runs migrations (DDL).
DB_ADMIN_USER=shortener_admin
DB_ADMIN_PASSWORD=replace_with_a_strong_password

# Least-privilege role the application connects as: DML only, no DDL, no superuser.
APP_DB_USER=shortener_app
APP_DB_PASSWORD=replace_with_a_different_strong_password

# --- Application ---
# Public base URL: used to build shortUrls and to reject self-referential targets.
BASE_URL=http://localhost:8080

# Comma-separated CORS allow-list. Leave empty to disable cross-origin access. Never use "*".
# In the Caddy-proxy production setup the frontend calls the API same-origin, so this stays empty.
CORS_ALLOWED_ORIGINS=

# Shared secret that gates the management routes (POST /links, stats, delete). In production the
# Caddy proxy injects it as X-Internal-Key server-side (it never reaches the browser); set the same
# value here and on the web service. Leave empty locally to keep those routes open. The redirect
# endpoint stays public regardless. Generate with `openssl rand -base64 32`.
INTERNAL_API_KEY=

# Trust X-Forwarded-For for the client IP (per-IP rate limiting). Set true ONLY when a trusted proxy
# sits in front (Railway's edge). Leave false for direct/local runs, or clients could spoof it.
TRUST_PROXY_HEADERS=false
